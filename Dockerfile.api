# Stage 1: Build da aplicação Go
FROM golang:1.26-alpine AS builder

WORKDIR /app

# Dependências do sistema para o build
RUN apk add --no-cache git ca-certificates tzdata

# Cache de dependências
COPY go.mod go.sum ./
RUN go mod download

# Copiar código fonte
COPY . .

# Compilar binário estático da API
RUN CGO_ENABLED=0 GOOS=linux GOARCH=amd64 go build \
    -ldflags="-w -s" \
    -o /app/bin/api ./cmd/api

# Stage 2: Imagem final mínima e segura
FROM alpine:3.19

WORKDIR /app

# Certificados SSL e timezone
RUN apk add --no-cache ca-certificates tzdata && \
    addgroup -S appgroup && adduser -S appuser -G appgroup

# Copiar binário compilado do builder
COPY --from=builder /app/bin/api /app/api

# Permissões do usuário não-root
USER appuser

EXPOSE 8080

HEALTHCHECK --interval=15s --timeout=3s --retries=3 \
  CMD wget --no-verbose --tries=1 --spider http://localhost:8080/health/live || exit 1

ENTRYPOINT ["/app/api"]
